{
    "name": "project-web",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@12.3.1",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.19.0",
            "onFail": "download"
        }
    },
    "scripts": {
        "refresh:publication": "node scripts/sync-publication-snapshot.mjs",
        "generate:art": "node scripts/generate-crafted-subject-art.mjs && node scripts/artwork/build-public-asset-metadata.mjs",
        "generate:god-symbols": "uv run scripts/artwork/generate-god-symbols.py && node scripts/artwork/build-public-asset-metadata.mjs",
        "generate:responsive-art": "node scripts/artwork/generate-responsive-art.mjs",
        "publish:art": "node scripts/artwork/publish-optimized-assets.mjs && node scripts/artwork/build-public-asset-metadata.mjs",
        "optimize:raster-art": "node scripts/artwork/optimize-raster-deliveries.mjs && node scripts/artwork/apply-optimized-raster-deliveries.mjs && node scripts/artwork/build-public-asset-metadata.mjs",
        "prune:art": "node scripts/artwork/prune-public-assets.mjs --apply",
        "generate:art-manifest": "node scripts/artwork/build-production-art-manifest.mjs",
        "generate:seo-images": "node scripts/generate-seo-images.mjs",
        "generate:phosphor-icons": "node scripts/generate-phosphor-subset.mjs",
        "verify:generated": "node scripts/verify-generated-assets.mjs",
        "dev": "astro dev",
        "build": "pnpm verify:generated && node scripts/artwork/generate-responsive-art.mjs --check && node scripts/audit-phosphor-subset.mjs && astro build && node scripts/audit-runtime-assets.mjs && node scripts/audit-public-output.mjs && node scripts/audit-player-information.mjs && node scripts/audit-keyboard-interactions.mjs",
        "preview": "astro preview",
        "astro": "astro",
        "test:e2e": "pnpm exec playwright test --config=playwright.config.ts",
        "typecheck": "astro check",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.3",
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
        "@fontsource-variable/cinzel": "^5.3.0",
        "@nanostores/persistent": "^1.3.5",
        "@phosphor-icons/web": "^2.1.2",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/virtual-core": "^3.17.8",
        "astro": "^7.2.4",
        "nanostores": "^1.5.1",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@playwright/test": "^1.62.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.2.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.1.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sharp": "^0.35.3",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "8.2.1"
    }
}

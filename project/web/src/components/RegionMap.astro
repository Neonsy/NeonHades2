const { region } = Astro.props;
const map = maps[region];
if (!map) throw new Error(`Missing authored region map for ${region}`);
const mapId = region
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
---

<figure
    class='region-map'
    data-region-map={mapId}
    style={`--map-accent:${map.accent};--map-secondary:${map.secondary}`}
    aria-labelledby={`${mapId}-map-title ${mapId}-map-caption`}>
    <svg viewBox='0 0 960 560' role='img'>
        <title id={`${mapId}-map-title`}>{region} route map</title>
        <desc>{map.caption}</desc>
        <defs>
            <linearGradient id={`${mapId}-ground`} x1='0' y1='0' x2='1' y2='1'>
                <stop offset='0' stop-color='#111b25'></stop>
                <stop offset='.52' stop-color='#121722'></stop>
                <stop offset='1' stop-color='#171324'></stop>
            </linearGradient>
            <pattern id={`${mapId}-grid`} width='34' height='34' patternUnits='userSpaceOnUse'>
                <path d='M34 0H0V34' fill='none' stroke='currentColor' stroke-opacity='.08'></path>
            </pattern>
            <filter id={`${mapId}-glow`} x='-60%' y='-60%' width='220%' height='220%'>
                <feGaussianBlur stdDeviation='7' result='blur'></feGaussianBlur>
                <feMerge><feMergeNode in='blur'></feMergeNode><feMergeNode in='SourceGraphic'></feMergeNode></feMerge>
            </filter>
            <clipPath id={`${mapId}-art-clip`}>
                <path d='M43 77L70 50H890L917 77V483L890 510H70L43 483Z'></path>
            </clipPath>
            <linearGradient id={`${mapId}-art-veil`} x1='0' y1='0' x2='0' y2='1'>
                <stop offset='0' stop-color='#060a10' stop-opacity='.24'></stop>
                <stop offset='.56' stop-color='#070a11' stop-opacity='.12'></stop>
                <stop offset='1' stop-color='#05070c' stop-opacity='.48'></stop>
            </linearGradient>
        </defs>

        <path d='M30 68L62 36H898L930 68V492L898 524H62L30 492Z' fill='#080d14' stroke='#05070d' stroke-width='14'
        ></path>
        <path
            d='M43 77L70 50H890L917 77V483L890 510H70L43 483Z'
            fill={`url(#${mapId}-ground)`}
            stroke='var(--map-accent)'
            stroke-opacity='.38'
            stroke-width='2'></path>
        <g clip-path={`url(#${mapId}-art-clip)`}>
            <image
                class='region-map__art'
                href={`/art/regions/${mapId}.webp`}
                x='43'
                y='50'
                width='874'
                height='460'
                preserveAspectRatio='xMidYMid slice'
            />
            <rect x='43' y='50' width='874' height='460' fill={`url(#${mapId}-art-veil)`}></rect>
            <rect x='55' y='62' width='850' height='436' fill={`url(#${mapId}-grid)`} color='var(--map-secondary)'
            ></rect>
        </g>

        <g class='region-map__terrain'>
            {map.terrain.map((path) => <path d={path} />)}
        </g>
        <g class='region-map__contours'>
            {map.contours.map((path) => <path d={path} />)}
        </g>

        <path class='region-map__route-shadow' d={map.path}></path>
        <path class='region-map__route' d={map.path}></path>

        {
            map.landmarks.map((landmark, index) => (
                <g class={`region-map__landmark region-map__landmark--${landmark.kind}`}>
                    <circle cx={landmark.x} cy={landmark.y} r={index === map.landmarks.length - 1 ? 19 : 14} />
                    {landmark.kind === 'grove' && (
                        <g transform={`translate(${landmark.x - 13} ${landmark.y - 14})`}>
                            <path d='M4 22L11 8L18 22ZM14 24L22 5L30 24Z' />
                        </g>
                    )}
                    {landmark.kind === 'water' && (
                        <path
                            d={`M${landmark.x - 11} ${landmark.y}Q${landmark.x} ${landmark.y - 13} ${landmark.x + 11} ${landmark.y}Q${landmark.x} ${landmark.y + 13} ${landmark.x - 11} ${landmark.y}Z`}
                        />
                    )}
                    {landmark.kind === 'gate' && (
                        <path
                            d={`M${landmark.x - 10} ${landmark.y + 10}V${landmark.y - 5}Q${landmark.x} ${landmark.y - 17} ${landmark.x + 10} ${landmark.y - 5}V${landmark.y + 10}`}
                        />
                    )}
                    {landmark.kind === 'ship' && (
                        <path
                            d={`M${landmark.x - 15} ${landmark.y + 4}H${landmark.x + 15}L${landmark.x + 8} ${landmark.y + 12}H${landmark.x - 8}ZM${landmark.x} ${landmark.y + 2}V${landmark.y - 13}L${landmark.x + 12} ${landmark.y - 2}Z`}
                        />
                    )}
                    {landmark.kind === 'city' && (
                        <path
                            d={`M${landmark.x - 13} ${landmark.y + 11}V${landmark.y - 9}H${landmark.x - 4}V${landmark.y - 2}H${landmark.x + 4}V${landmark.y - 13}H${landmark.x + 13}V${landmark.y + 11}Z`}
                        />
                    )}
                    {landmark.kind === 'peak' && (
                        <path
                            d={`M${landmark.x - 14} ${landmark.y + 11}L${landmark.x} ${landmark.y - 14}L${landmark.x + 14} ${landmark.y + 11}L${landmark.x + 4} ${landmark.y + 3}L${landmark.x - 2} ${landmark.y + 8}L${landmark.x - 7} ${landmark.y + 1}Z`}
                        />
                    )}
                    {landmark.kind === 'void' && (
                        <path
                            d={`M${landmark.x} ${landmark.y - 13}C${landmark.x + 17} ${landmark.y - 5} ${landmark.x + 13} ${landmark.y + 14} ${landmark.x - 3} ${landmark.y + 12}C${landmark.x - 17} ${landmark.y + 9} ${landmark.x - 16} ${landmark.y - 7} ${landmark.x} ${landmark.y - 13}Z`}
                        />
                    )}
                    {landmark.kind === 'guardian' && (
                        <path
                            d={`M${landmark.x} ${landmark.y - 15}L${landmark.x + 14} ${landmark.y - 4}L${landmark.x + 9} ${landmark.y + 14}H${landmark.x - 9}L${landmark.x - 14} ${landmark.y - 4}Z`}
                        />
                    )}
                </g>
            ))
        }

        <g class='region-map__compass' transform='translate(844 420)'>
            <circle r='31'></circle>
            <path d='M0-24L7 0L0 24L-7 0Z'></path>
            <path d='M-24 0L0 7L24 0L0-7Z'></path>
        </g>
    </svg>
    <div class='region-map__key'>
        <dl>
            <div><dt>Route</dt><dd>{map.route}</dd></div>
            <div><dt>Position</dt><dd>{map.position}</dd></div>
        </dl>
        <ul aria-label='Map landmarks'>
            {map.landmarks.map((landmark) => <li>{landmark.label}</li>)}
        </ul>
    </div>
    <figcaption id={`${mapId}-map-caption`}>
        <strong>{region}</strong>
        <span>{map.caption}</span>
    </figcaption>
</figure>

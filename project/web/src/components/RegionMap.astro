---
type LandmarkKind = 'entry' | 'grove' | 'water' | 'gate' | 'ship' | 'city' | 'peak' | 'void' | 'guardian';

type Landmark = {
    x: number;
    y: number;
    label: string;
    kind: LandmarkKind;
};

type RegionMapDefinition = {
    route: string;
    position: string;
    caption: string;
    accent: string;
    secondary: string;
    terrain: string[];
    contours: string[];
    path: string;
    landmarks: Landmark[];
};

type Props = {
    region: string;
};


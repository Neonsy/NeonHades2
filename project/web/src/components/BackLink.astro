---
type Props = {
    href: string;
    label: string;
    class?: string;
};

const { href, label, class: className } = Astro.props;
---

<a class:list={['back-link', className]} href={href}>
    <i class='ph ph-arrow-left' aria-hidden='true'></i>
    <span class='back-link__label'>{label}</span>
</a>

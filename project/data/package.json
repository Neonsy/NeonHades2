{
  "name": "@neodes2/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "arcana:audit": "tsc -p tsconfig.build.json && node dist/arcana-source-audit-cli.js",
    "arcana:import": "tsc -p tsconfig.build.json && node dist/arcana-runtime-import-cli.js",
    "arcana:preflight": "tsc -p tsconfig.build.json && node dist/arcana-preflight-cli.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "contract:check": "tsc -p tsconfig.build.json && node dist/validate-contract.js",
    "dataset:build": "tsc -p tsconfig.build.json && node dist/dataset-build-cli.js",
    "guide:audit": "tsc -p tsconfig.build.json && node dist/guide-source-audit-cli.js",
    "guide:import": "tsc -p tsconfig.build.json && node dist/guide-runtime-import-cli.js",
    "guide:preflight": "tsc -p tsconfig.build.json && node dist/guide-preflight-cli.js",
    "loadouts:audit": "tsc -p tsconfig.build.json && node dist/loadout-source-audit-cli.js",
    "loadouts:import": "tsc -p tsconfig.build.json && node dist/loadout-runtime-import-cli.js",
    "loadouts:preflight": "tsc -p tsconfig.build.json && node dist/loadout-preflight-cli.js",
    "observation:import": "tsc -p tsconfig.build.json && node dist/observation-import-cli.js",
    "observer:config": "tsc -p tsconfig.build.json && node dist/observer-config-cli.js",
    "runtime:import": "tsc -p tsconfig.build.json && node dist/runtime-import-cli.js",
    "snapshot": "tsc -p tsconfig.build.json && node dist/snapshot-cli.js",
    "test": "tsc -p tsconfig.test.json && node --test .local/test-dist/test/*.test.js",
    "verification:build": "tsc -p tsconfig.build.json && node dist/verification-build-cli.js",
    "weapons:audit": "tsc -p tsconfig.build.json && node dist/weapon-source-audit-cli.js",
    "weapons:import": "tsc -p tsconfig.build.json && node dist/weapon-runtime-import-cli.js",
    "weapons:preflight": "tsc -p tsconfig.build.json && node dist/weapon-preflight-cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
